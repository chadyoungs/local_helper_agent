# Local Helper Agent - environment configuration
# Copy this file to `.env` and adjust values as needed.

# --- Server ---
HOST=127.0.0.1
PORT=5001

# --- LLM (provider) ---
# Inference provider: "ollama" (default) or "lmstudio" (OpenAI-compatible).
LLM_PROVIDER=ollama

# Ollama backend:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   Pull a model first:  ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LM Studio backend (start a model in LM Studio -> Developer mode, exposing
# http://127.0.0.1:1234/v1). Requires:  pip install openai
LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# Model to use.
OLLAMA_MODEL=qwen2.5:7b-instruct
TEMPERATURE=0

# Use native function-calling API when the model supports it.
# When false (default), the agent uses strict structured-JSON generation with
# schema validation and self-correction retries -- more deterministic locally.
ENABLE_NATIVE_TOOLS=false

# --- Agent loop ---
# Maximum tool-calling steps per turn (hard budget against infinite loops).
MAX_AGENT_STEPS=5
# Retries for invalid structured JSON before giving up.
JSON_RETRIES=2
# Cap on tool output characters fed back to the model (history hygiene).
TOOL_OUTPUT_MAX_CHARS=3000

# --- Tool sandbox / subprocess ---
TOOL_TIMEOUT_SECONDS=120


# --- CORS ---
# Comma-separated origins allowed. "null" is the Origin sent by browsers when
# the page is opened via file:// .
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001,null
